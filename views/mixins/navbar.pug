mixin navbar(brandName, navItems, activePath)
  nav.header-nav.nav
    a.header-logo(href='/')
      img(src='/favicon/camel-logo.jpg', alt='Logo')
      span= brandName
    ul.nav
      each item in navItems
        li
          a(
            href=item.url
            class={ active: activePath === item.url }
          )= item.label

//- Define data in the unbuffered JavaScript block
-
  const menu = [
    { label: 'Home', url: '/' },
    { label: 'Men', url: '/men' },
    { label: 'Women', url: '/women' },
    { label: 'Kids', url: '/kids' },
    { label: 'About', url: '/about' },
    { label: 'Contact', url: '/contact' }
  ];

//- Call the mixin
+navbar('The Camel Road', menu, activePath)