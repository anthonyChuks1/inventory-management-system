extends layout
include mixins/product-card

block content
  section.hero
    .wrap
      div
        h1
          | Gear built for
          br
          em the long road
        p Durable, weather-ready clothing for men, women and kids. Designed to move, made to last.
      a.btn.btn--accent(href='/products') Shop all products

  .wrap
    if error
      .alert= error

    h2.toolbar
      span.count Featured Products

    if products && products.length
      .grid
        each product in products
          +productCard(product, stockBadge)
    else
      .empty
        h3 No products yet
        p Check back soon, or add some products to your catalog.
